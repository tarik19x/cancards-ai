**/AGENTS.md
/LLM/

# Playwright / test runner output
test-results/
playwright-report/

# Dev-script caches of Pinecone corpus text and Claude responses (contain PDF text)
backend/data/cache/
tests/evals/hard_questions_review.json

# No PDF ever belongs in this repo: the bank documents are copyrighted and
# re-downloadable (backend/scripts/fetch_documents.py), and a stray copy in any
# other folder would otherwise be committed. Extracted text is just as sensitive,
# so the dev caches and the judge/review files that embed it are ignored too.
*.pdf
backend/data/cache/
backend/data/documents/pdf/
tests/evals/hard_questions_review.json
LLM/hard_questions_full.json
*.tmp

# Local Postgres data and scratch files from the coach's conversation tests.
pgdata/

# Local spend and load-test logs. usage_log.jsonl is a running record of what the Claude
# calls cost (written by app/clients/usage.py); it is personal and should never be pushed.
**/usage_log*.jsonl
*.log
*.bak
